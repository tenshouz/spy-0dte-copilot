// PRD Section 15 — database schema of record.
// Milestone 1: schema only, no migrations run against a real database yet.
// Milestone 2+ will run `prisma migrate dev` once Postgres is provisioned.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  schwabTokens SchwabToken?
  settings     Settings?
  journalSnapshots DeterministicJournalSnapshot[]
  automationRuntime BackendAutomationRuntime?
  automationDeliveryKeys BackendAutomationDeliveryKey[]
  automationDeliveryLogs BackendAutomationDeliveryLog[]
  createdAt    DateTime     @default(now())
}

model SchwabToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  accessToken  String // encrypted at rest
  refreshToken String // encrypted at rest
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

model Settings {
  id                               String   @id @default(cuid())
  userId                           String   @unique
  user                             User     @relation(fields: [userId], references: [id])
  discordWebhookUrl                String?
  alertPreferences                 Json // per-message-type toggles
  scoringRulesVersion              String   @default("v1")
  backendAutomationEnabled         Boolean  @default(false)
  backendTradePlanAlertsEnabled    Boolean  @default(true)
  backendScheduledReportsEnabled   Boolean  @default(true)
  backendAutomationCadenceSeconds  Int      @default(30)
  updatedAt                        DateTime @updatedAt
}

model MarketSnapshot {
  id                String    @id @default(cuid())
  timestamp         DateTime  @default(now())
  spotPrice         Float
  vwap              Float
  openingRangeHigh  Float?
  openingRangeLow   Float?
  premarketHigh     Float?
  premarketLow      Float?
  overnightHigh     Float?
  overnightLow      Float?
  trend5m           String
  trend1m           String
  volume            Float
  relativeVolume    Float
  emaTrend          String
  netGex            Float
  netDex            Float
  gammaFlip         Float?
  callWall          Float?
  putWall           Float?
  dealerPositioning String
  expectedMove      Float
  ivRank            Float?
  expirationUsed    DateTime
  reports           Report[]
}

model Report {
  id              String         @id @default(cuid())
  type            String // "premarket" | "0935" | "0945" | "1000" | "continuous" | "manual"
  snapshotId      String
  snapshot        MarketSnapshot @relation(fields: [snapshotId], references: [id])
  bias            String // "CALLS" | "PUTS" | "WAIT"
  confidence      Int
  bullishScenario String
  bearishScenario String
  tradePlan       Json // { entryCondition, targets[], invalidation, riskNote }
  warnings        Json // string[]
  reasoning       String
  factorScores    Json // [{ factor, points, detail }]
  screenshotUrl   String?
  createdAt       DateTime       @default(now())
  journalEntry    JournalEntry?
}

model JournalEntry {
  id          String   @id @default(cuid())
  reportId    String   @unique
  report      Report   @relation(fields: [reportId], references: [id])
  traded      Boolean  @default(false)
  direction   String? // "CALLS" | "PUTS"
  entryPrice  Float?
  exitPrice   Float?
  pnl         Float?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DeterministicJournalSnapshot {
  id                     String   @id
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentMarketDate      String
  sourceCalculatedAt     DateTime
  capturedAt             DateTime @default(now())
  captureMode            String   @default("EXPLICIT")
  sourceReferenceType    String?
  sourceReferenceKey     String?
  engineState            String
  planState              String
  direction              String
  confidenceScore        Float?
  primaryReasonCode      String
  warningCode            String?
  entryConditionState    String
  selectedContractSymbol String?
  sourceAssembly         Json
  outcomeState           String   @default("UNREVIEWED")
  realizedPnlDollars     Float?
  outcomeNotes           String?
  outcomeUpdatedAt       DateTime?

  @@index([userId, capturedAt])
  @@index([userId, currentMarketDate])
  @@index([userId, outcomeState])
  @@index([userId, captureMode])
  @@unique([userId, sourceReferenceKey])
}

model DiscordLog {
  id          String   @id @default(cuid())
  messageType String
  payload     Json
  status      String // "sent" | "failed" | "retrying"
  createdAt   DateTime @default(now())
}


model BackendAutomationRuntime {
  id                         String   @id
  userId                     String   @unique
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaseOwner                 String?
  leaseExpiresAt             DateTime?
  lastHeartbeatAt            DateTime?
  lastTickAt                 DateTime?
  lastTradePlanEvaluatedAt   DateTime?
  lastTradePlanOutcome       String?
  lastTradePlanReasonCode    String?
  lastScheduledEvaluatedAt   DateTime?
  lastScheduledOutcome       String?
  lastScheduledReasonCode    String?
  lastErrorCode              String?
  tradePlanTransitionState   Json
  updatedAt                  DateTime @updatedAt
}

model BackendAutomationDeliveryKey {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      String
  deliveryKey   String
  commitment    String
  committedAt   DateTime @default(now())

  @@unique([userId, category, deliveryKey])
  @@index([userId, committedAt])
}

model BackendAutomationDeliveryLog {
  id                       String   @id @default(cuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category                 String
  triggerMode              String
  deliveryKey              String?
  deliveryState            String
  reasonCode               String
  providerStatusCode       Int?
  providerRequestAttempted Boolean  @default(false)
  transitionType           String?
  reportType               String?
  attemptedAt              DateTime @default(now())
  details                  Json

  @@index([userId, attemptedAt])
  @@index([userId, category, attemptedAt])
}
