// V1 PostgreSQL schema of record. Migrations under prisma/migrations are the authoritative deployment history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  schwabTokens SchwabToken?
  settings     Settings?
  journalSnapshots DeterministicJournalSnapshot[]
  automationRuntime BackendAutomationRuntime?
  automationDeliveryKeys BackendAutomationDeliveryKey[]
  automationDeliveryLogs BackendAutomationDeliveryLog[]
  historicalReplayRuns HistoricalReplayRun[]
  decisionCycles DeterministicDecisionCycle[]
  pointInTimeOptionsChains PointInTimeOptionsChainSnapshot[]
  pointInTimeBacktestRuns PointInTimeBacktestRun[]
  tradingDayLedgers TradingDayLedger[]
  tradingPositions TradingPosition[]
  tradingAttempts TradingAttempt[]
  tradingReadyAlerts TradingReadyAlert[]
  tradingRestrictedEvents TradingRestrictedEvent[]
  tradingWorkspaceRuntime TradingWorkspaceRuntime?
  tradingWorkspaceEvents TradingWorkspaceEvent[]
  tradingManualOverrides TradingManualOverride[]
  createdAt    DateTime     @default(now())
}

model SchwabToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  accessToken  String // encrypted at rest
  refreshToken String // encrypted at rest
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

model Settings {
  id                               String   @id @default(cuid())
  userId                           String   @unique
  user                             User     @relation(fields: [userId], references: [id])
  discordWebhookUrl                String?
  alertPreferences                 Json // per-message-type toggles
  scoringRulesVersion              String   @default("v1")
  backendAutomationEnabled         Boolean  @default(false)
  backendTradePlanAlertsEnabled    Boolean  @default(true)
  backendScheduledReportsEnabled   Boolean  @default(true)
  backendAutomationCadenceSeconds  Int      @default(30)
  updatedAt                        DateTime @updatedAt
}

model MarketSnapshot {
  id                String    @id @default(cuid())
  timestamp         DateTime  @default(now())
  spotPrice         Float
  vwap              Float
  openingRangeHigh  Float?
  openingRangeLow   Float?
  premarketHigh     Float?
  premarketLow      Float?
  overnightHigh     Float?
  overnightLow      Float?
  trend5m           String
  trend1m           String
  volume            Float
  relativeVolume    Float
  emaTrend          String
  netGex            Float
  netDex            Float
  gammaFlip         Float?
  callWall          Float?
  putWall           Float?
  dealerPositioning String
  expectedMove      Float
  ivRank            Float?
  expirationUsed    DateTime
  reports           Report[]
}

model Report {
  id              String         @id @default(cuid())
  type            String // "premarket" | "0935" | "0945" | "1000" | "continuous" | "manual"
  snapshotId      String
  snapshot        MarketSnapshot @relation(fields: [snapshotId], references: [id])
  bias            String // "CALLS" | "PUTS" | "WAIT"
  confidence      Int
  bullishScenario String
  bearishScenario String
  tradePlan       Json // { entryCondition, targets[], invalidation, riskNote }
  warnings        Json // string[]
  reasoning       String
  factorScores    Json // [{ factor, points, detail }]
  screenshotUrl   String?
  createdAt       DateTime       @default(now())
  journalEntry    JournalEntry?
}

model JournalEntry {
  id          String   @id @default(cuid())
  reportId    String   @unique
  report      Report   @relation(fields: [reportId], references: [id])
  traded      Boolean  @default(false)
  direction   String? // "CALLS" | "PUTS"
  entryPrice  Float?
  exitPrice   Float?
  pnl         Float?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DeterministicJournalSnapshot {
  id                     String   @id
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentMarketDate      String
  sourceCalculatedAt     DateTime
  capturedAt             DateTime @default(now())
  captureMode            String   @default("EXPLICIT")
  sourceReferenceType    String?
  sourceReferenceKey     String?
  engineState            String
  planState              String
  direction              String
  confidenceScore        Float?
  primaryReasonCode      String
  warningCode            String?
  entryConditionState    String
  selectedContractSymbol String?
  sourceAssembly         Json
  outcomeState           String   @default("UNREVIEWED")
  realizedPnlDollars     Float?
  outcomeNotes           String?
  outcomeUpdatedAt       DateTime?

  @@index([userId, capturedAt])
  @@index([userId, currentMarketDate])
  @@index([userId, outcomeState])
  @@index([userId, captureMode])
  @@unique([userId, sourceReferenceKey])
}

model DiscordLog {
  id          String   @id @default(cuid())
  messageType String
  payload     Json
  status      String // "sent" | "failed" | "retrying"
  createdAt   DateTime @default(now())
}


model BackendAutomationRuntime {
  id                         String   @id
  userId                     String   @unique
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaseOwner                 String?
  leaseExpiresAt             DateTime?
  lastHeartbeatAt            DateTime?
  lastTickAt                 DateTime?
  lastTradePlanEvaluatedAt   DateTime?
  lastTradePlanOutcome       String?
  lastTradePlanReasonCode    String?
  lastScheduledEvaluatedAt   DateTime?
  lastScheduledOutcome       String?
  lastScheduledReasonCode    String?
  lastErrorCode              String?
  tradePlanTransitionState   Json
  updatedAt                  DateTime @updatedAt
}

model BackendAutomationDeliveryKey {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      String
  deliveryKey   String
  commitment    String
  committedAt   DateTime @default(now())

  @@unique([userId, category, deliveryKey])
  @@index([userId, committedAt])
}

model BackendAutomationDeliveryLog {
  id                       String   @id @default(cuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category                 String
  triggerMode              String
  deliveryKey              String?
  deliveryState            String
  reasonCode               String
  providerStatusCode       Int?
  providerRequestAttempted Boolean  @default(false)
  transitionType           String?
  reportType               String?
  attemptedAt              DateTime @default(now())
  details                  Json

  @@index([userId, attemptedAt])
  @@index([userId, category, attemptedAt])
}


model HistoricalReplayRun {
  id                String   @id
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  startMarketDate   String?
  endMarketDate     String?
  snapshotCount     Int
  marketDateCount   Int
  auditState        String
  auditFailureCount Int
  stateChangeCount  Int
  tradeOutcomeCount Int
  totalPnlDollars   Float?
  result            Json

  @@index([userId, createdAt])
  @@index([userId, auditState, createdAt])
}

model DeterministicDecisionCycle {
  id                       String   @id @default(cuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceReferenceKey       String
  currentMarketDate        String
  sourceCalculatedAt       DateTime
  capturedAt               DateTime @default(now())
  engineState              String
  planState                String
  direction                String
  setupType                String?
  triggerLifecycleState    String?
  confirmationPassed       Boolean?
  executionAlignmentScore  Float?
  snapshotIntegrityState   String?
  selectedContractSymbol   String?
  primaryReasonCode        String
  warningCode              String?
  sourceAssembly           Json
  sourceMarketState        Json?
  optionsChainSnapshotId   String?
  optionsChainSnapshot     PointInTimeOptionsChainSnapshot? @relation(fields: [optionsChainSnapshotId], references: [id], onDelete: SetNull)

  @@unique([userId, sourceReferenceKey])
  @@index([userId, capturedAt])
  @@index([userId, currentMarketDate, capturedAt])
  @@index([userId, planState, capturedAt])
  @@index([userId, setupType, capturedAt])
}



model PointInTimeOptionsChainSnapshot {
  id                String   @id
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceKey         String
  currentMarketDate String
  fetchedAt         DateTime
  capturedAt        DateTime @default(now())
  metricState       String
  sourceState       String
  payload           Json
  decisionCycles    DeterministicDecisionCycle[]

  @@unique([userId, sourceKey])
  @@index([userId, fetchedAt])
  @@index([userId, currentMarketDate, fetchedAt])
}

model PointInTimeBacktestRun {
  id                   String   @id
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  startMarketDate      String?
  endMarketDate        String?
  maximumHoldMinutes   Int
  decisionCycleCount   Int
  episodeCount         Int
  targetFirstCount     Int
  stopFirstCount       Int
  winRatePercent       Float?
  averageRMultiple     Float?
  result               Json

  @@index([userId, createdAt])
}

model TradingDayLedger {
  id                       String   @id @default(cuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketDate               String
  policyVersion            String
  realizedPnlDollars       Float    @default(0)
  realizedLossDollars      Float    @default(0)
  openPlannedRiskDollars   Float    @default(0)
  tradeCount               Int      @default(0)
  consecutiveLosses        Int      @default(0)
  updatedAt                DateTime @updatedAt
  createdAt                DateTime @default(now())

  @@unique([userId, marketDate])
  @@index([userId, marketDate])
}

model TradingPosition {
  id                       String   @id
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketDate               String
  policyVersion            String
  setupId                  String
  setupEpisodeId           String
  opportunityId            String
  readyAlertId             String?  @unique
  readyAlert               TradingReadyAlert? @relation(fields: [readyAlertId], references: [id], onDelete: SetNull)
  direction                String
  status                   String
  quantity                 Int      @default(1)
  contractSymbol           String
  strikePrice              Float
  expirationDate           String
  plannedEntryAsk          Float
  modeledEntryPrice        Float
  actualEntryPrice         Float
  entryUnderlyingPrice     Float
  structuralStopLevel      Float
  target1Level             Float
  target2Level             Float
  target3Level             Float?
  plannedRiskDollars       Float
  sourceSnapshot           Json
  openedAt                 DateTime
  timeStopReviewAt         DateTime
  target1TouchedAt         DateTime?
  target2TouchedAt         DateTime?
  target3TouchedAt         DateTime?
  stopTouchedAt            DateTime?
  timeStopAlertedAt        DateTime?
  mandatoryExitAlertedAt   DateTime?
  closedAt                 DateTime?
  actualExitPrice          Float?
  exitReason               String?
  realizedPnlDollars       Float?
  overrideReason           String?
  entryNote                String?
  exitNote                 String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  marks                     TradingPositionMark[]
  attempt                   TradingAttempt?

  @@index([userId, marketDate, status])
  @@index([userId, openedAt])
  @@index([userId, setupEpisodeId])
}

model TradingAttempt {
  id                       String   @id @default(cuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketDate               String
  setupId                  String
  setupEpisodeId           String
  direction                String
  levelType                String
  levelBucket              String
  attemptNumber            Int
  positionId               String?  @unique
  position                 TradingPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  outcome                  String   @default("OPEN")
  createdAt                DateTime @default(now())
  closedAt                 DateTime?

  @@unique([userId, setupEpisodeId, attemptNumber])
  @@index([userId, marketDate, createdAt])
  @@index([userId, setupEpisodeId])
}

model TradingReadyAlert {
  id                       String   @id
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketDate               String
  opportunityId            String
  setupEpisodeId           String
  status                   String
  issuedAt                 DateTime
  expiresAt                DateTime
  confirmedAt              DateTime?
  revokedAt                DateTime?
  closedReasonCode         String?
  snapshot                 Json
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  position                  TradingPosition?

  @@index([userId, marketDate, status])
  @@index([userId, opportunityId, issuedAt])
  @@index([userId, expiresAt])
}

model TradingRestrictedEvent {
  id                       String   @id
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketDate               String
  eventType                String
  title                    String
  blockMode                String
  windowStartAt            DateTime?
  windowEndAt              DateTime?
  enabled                  Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([userId, marketDate, enabled])
}

model TradingWorkspaceRuntime {
  id                       String   @id
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaseOwner               String?
  leaseExpiresAt           DateTime?
  lastHeartbeatAt          DateTime?
  lastEvaluationAt         DateTime?
  lastOutcome              String?
  lastErrorCode            String?
  updatedAt                DateTime @updatedAt
}

model TradingWorkspaceEvent {
  id                       String   @id
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketDate               String
  eventType                String
  severity                 String
  dedupeKey                String
  relatedReadyAlertId      String?
  relatedPositionId        String?
  payload                  Json
  discordDeliveryState     String   @default("PENDING")
  discordDeliveredAt       DateTime?
  providerStatusCode       Int?
  createdAt                DateTime @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, discordDeliveryState, createdAt])
}

model TradingPositionMark {
  id                       String   @id @default(cuid())
  positionId               String
  position                 TradingPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  markType                 String
  observedAt               DateTime
  underlyingPrice          Float?
  contractBid              Float?
  contractAsk              Float?
  modeledExitPrice         Float?
  modeledNetPnlDollars     Float?
  sourceState              String
  sourceSnapshot           Json?
  createdAt                DateTime @default(now())

  @@unique([positionId, markType])
  @@index([positionId, observedAt])
}

model TradingManualOverride {
  id                       String   @id @default(cuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketDate               String
  action                   String
  reason                   String
  relatedOpportunityId     String?
  relatedPositionId        String?
  sourceEngineState        Json
  createdAt                DateTime @default(now())

  @@index([userId, marketDate, createdAt])
}
