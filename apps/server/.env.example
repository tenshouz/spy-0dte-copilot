# Local PostgreSQL database. Required for encrypted Schwab tokens, Journal,
# replay, persistent automation settings, deduplication, and delivery history.
DATABASE_URL="postgresql://spy:spy_password@localhost:5432/spy_copilot?schema=public"
PORT=4000
FRONTEND_URL="http://localhost:3000"

# Optional local single-user identity key used for persisted records.
SCHWAB_DEFAULT_USER_EMAIL="trader@local"

# Schwab OAuth and read-only market/account-risk connectivity.
SCHWAB_CLIENT_ID=""
SCHWAB_CLIENT_SECRET=""
# Must exactly match the HTTPS callback registered with Schwab and end with:
# /api/auth/schwab/callback
SCHWAB_REDIRECT_URI=""
# 32+ character random value used to encrypt access and refresh tokens at rest.
SCHWAB_TOKEN_ENCRYPTION_KEY=""

# Optional Discord incoming webhook. Keep the real value only in .env.
# It is never returned to the browser or stored in delivery audit records.
DISCORD_WEBHOOK_URL=""
