# Local dev database (matches docker-compose.yml in the repo root — see README "Windows Quick Start").
# The mock API routes (snapshot/reports/journal/alerts) do not require this to be set.
DATABASE_URL="postgresql://spy:spy_password@localhost:5432/spy_copilot?schema=public"
PORT=4000

# Schwab OAuth (auth only — no market data calls yet). Leave blank until you have real Schwab
# developer credentials; the Settings page will show "Schwab credentials not configured" until then.
SCHWAB_CLIENT_ID=""
SCHWAB_CLIENT_SECRET=""
SCHWAB_REDIRECT_URI="http://localhost:4000/api/auth/schwab/callback"
# Long random string used to encrypt tokens at rest (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCHWAB_TOKEN_ENCRYPTION_KEY=""
FRONTEND_URL="http://localhost:3000"
