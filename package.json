{
  "name": "spy-0dte-copilot",
  "private": true,
  "version": "1.5.1",
  "description": "Local SPY 0DTE deterministic decision-support platform — V1.5.1 Historical Replay Recovery",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:server": "npm run dev --workspace=apps/server",
    "build:web": "npm run build --workspace=apps/web",
    "build:server": "npm run build --workspace=apps/server",
    "lint": "npm run lint --workspace=apps/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate --workspace=apps/server -- --name init",
    "test:server": "node scripts/run-specs.mjs apps/server/src/services",
    "test:web": "node scripts/run-specs.mjs apps/web/src/lib",
    "test": "npm run test:server && npm run test:web",
    "verify:v1": "node scripts/verify-v1.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
